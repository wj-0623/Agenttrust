POST http://127.0.0.1:8010/api/v1/corrections/REPLACE_CORRECTION_ID/canary-observations
Content-Type: application/json

{"traffic_id":"REPLACE_TRAFFIC_ID","expected_action":"allow","reason":"Human reviewed legitimate customer request"}


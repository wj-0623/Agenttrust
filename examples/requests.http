Content-Type: application/json

{
  "project_id": "proj_demo",
  "idempotency_key": "refund-demo-low-001",
  "order_id": "order_demo_1001",
  "customer_id": "customer_demo",
  "amount": 30,
  "currency": "CNY",
  "reason": "商品包装破损",
  "evidence": {"attachment_scanned": true}
}


{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgentTrust: Setup",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\setup-windows.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "AgentTrust: API",
      "type": "process",
      "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8010"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "agenttrust-dev",
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "AgentTrust: Console",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "agenttrust-dev",
        "panel": "dedicated",
        "reveal": "always"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "AgentTrust: Start full stack",
      "dependsOn": ["AgentTrust: API", "AgentTrust: Console"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "AgentTrust: Verify",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\verify.ps1"
      ],
      "problemMatcher": [],
      "group": "test"
    }
  ]
}

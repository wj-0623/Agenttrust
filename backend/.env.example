AGENTTRUST_ENV=development
# Set from CI (for example, the immutable Git commit) so evaluation manifests are attributable.
AGENTTRUST_BUILD_REVISION=
AGENTTRUST_DB_PATH=./data/agenttrust.db
# Production SaaS uses PostgreSQL; local development may omit this variable.
AGENTTRUST_DATABASE_URL=
AGENTTRUST_MIGRATION_DATABASE_URL=
AGENTTRUST_POSTGRES_RLS=false
AGENTTRUST_POSTGRES_APP_ROLE=agenttrust_app
AGENTTRUST_DB_POOL_SIZE=10
# Production: run app.migrate separately, then disable startup migrations.
AGENTTRUST_AUTO_INITIALIZE=true
# Production bootstrap: inject at least 32 random bytes; never commit a real token.
AGENTTRUST_BOOTSTRAP_TOKEN=
AGENTTRUST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENTTRUST_REQUIRE_API_KEY=false
AGENTTRUST_OIDC_ISSUER=
AGENTTRUST_OIDC_AUDIENCE=agenttrust-api
AGENTTRUST_OIDC_JWKS_URL=
AGENTTRUST_OIDC_ALGORITHMS=RS256,ES256
AGENTTRUST_OIDC_JWKS_CACHE_SECONDS=300
AGENTTRUST_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=agenttrust-api
PHOENIX_PROJECT_NAME=agenttrust-security
PHOENIX_BASE_URL=
PHOENIX_API_KEY=
AGENTTRUST_TEMPORAL_ENABLED=false
AGENTTRUST_TEMPORAL_TARGET=localhost:7233
AGENTTRUST_TEMPORAL_NAMESPACE=default
AGENTTRUST_TEMPORAL_TASK_QUEUE=agenttrust-refunds-v2
AGENTTRUST_SECURITY_HSTS=false
AGENTTRUST_SANDBOX_TIMEOUT=2.0
AGENTTRUST_SANDBOX_MAX_OUTPUT=12000
AGENTTRUST_MAX_REQUEST_BODY_BYTES=1048576
AGENTTRUST_MAX_UPSTREAM_RESPONSE_BYTES=2097152
AGENTTRUST_DOCS_ENABLED=true
AGENTTRUST_DLP_ENABLED=true
AGENTTRUST_DLP_INPUT_ACTION=redact
AGENTTRUST_DLP_OUTPUT_ACTION=block
AGENTTRUST_AUDIT_ANCHOR_SECRET=
AGENTTRUST_SECURITY_WEBHOOK_URL=
AGENTTRUST_SECURITY_WEBHOOK_SECRET=
# Optional boto3 integration; bucket must already enable S3 Object Lock.
AGENTTRUST_AUDIT_WORM_BUCKET=
AGENTTRUST_AUDIT_WORM_RETENTION_DAYS=365
AGENTTRUST_CORRECTION_CANARY_MIN_OBSERVATIONS=50
AGENTTRUST_CORRECTION_CANARY_MAX_ERROR_RATE=0.01
AGENTTRUST_CORRECTION_CANARY_MAX_FALSE_POSITIVE_RATE=0.02
AGENTTRUST_CORRECTION_AUTO_PROMOTE_DEVELOPMENT=false
AGENTTRUST_CORRECTION_CANARY_PERCENT=10
AGENTTRUST_CORRECTION_MIN_BENIGN=25
AGENTTRUST_CORRECTION_MIN_ATTACKS=10
AGENTTRUST_CORRECTION_MIN_SECONDS=300
AGENTTRUST_CORRECTION_MAX_LATENCY_MS=5000
# Self-hosted semantic detector only. Disabled until explicitly configured.
AGENTTRUST_SEMANTIC_DETECTOR_URL=
AGENTTRUST_SEMANTIC_DETECTOR_KEY=
AGENTTRUST_SEMANTIC_DETECTOR_REQUIRED=false

# Optional: the demo target runs without any model key.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTTRUST_MODEL_ENDPOINT_ALLOWLIST=https://dashscope.aliyuncs.com/compatible-mode/v1
# Exact destinations for optional external Agents. Empty by default: no outbound Agent target is trusted implicitly.
AGENTTRUST_EXTERNAL_AGENT_ENDPOINT_ALLOWLIST=
# Required with HTTPS when AGENTTRUST_ENV=production; never place secrets in a project row.
AGENTTRUST_EXTERNAL_AGENT_BEARER_TOKEN=
QWEN_MODEL=qwen-plus
# Required before real model calls. Set current USD prices per million tokens
# for the selected model; -1 refuses paid calls. Explicit 0 means a free model.
AGENTTRUST_MODEL_INPUT_USD_PER_MILLION=-1
AGENTTRUST_MODEL_OUTPUT_USD_PER_MILLION=-1
